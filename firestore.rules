rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins list: each admin has a document with their user id. Create these by hand in the console.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Staff names: everyone using the app can search them, only admins can change them.
    match /staff/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Who is currently signed in (needed so a worker can sign out).
    match /status/{id} {
      allow read, write: if signedIn();
    }

    // Attendance records: workers can only add a record or set its sign-out time. Only admins can read them.
    match /attendance/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signOut']);
    }
  }
}
